# Copy this file to secrets.toml (same folder) and fill in your key.
# Get one free at https://the-odds-api.com (500 requests/mo on free tier).
the_odds_api_key = "YOUR_KEY_HERE"

# Optional: keep the pick ledger in a PRIVATE GitHub repo so the hosted copy
# does not lose it on every restart. See DEPLOY.md, "Keeping the ledger".
# Leave these out on your own computer.
# ledger_github_repo  = "your-user/edge-v2-data"
# ledger_github_token = "github_pat_..."
